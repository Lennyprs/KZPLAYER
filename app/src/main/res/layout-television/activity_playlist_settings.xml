<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/kzBg"
    android:padding="40dp"
    android:clipChildren="false"
    android:clipToPadding="false">
    <TextView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2190 Retour"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingBottom="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Liste de lecture"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisis le serveur / la liste active"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N\u00b0 DE LICENCE"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="2dp" />
    <TextView
        android:id="@+id/licenseTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/kzAccent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="20dp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/playlistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </ScrollView>
</LinearLayout>
