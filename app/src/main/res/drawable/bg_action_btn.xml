<?xml version="1.0" encoding="utf-8"?>
<!-- v396 : au focus le bouton devient BLANC + contour epais accent + petit curseur
     vertical a gauche. Combine a btn_action_text.xml, le texte passe en noir. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                    <corners android:radius="10dp" />
                    <stroke android:width="4dp" android:color="?attr/kzAccent" />
                </shape>
            </item>
            <item android:left="6dp" android:top="10dp" android:bottom="10dp" android:width="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kzAccent" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="4dp" android:color="?attr/kzAccent2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/kzCard" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="?attr/kzStroke" />
        </shape>
    </item>
</selector>
