<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_home"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:gravity="center_horizontal">
<ImageView android:layout_width="220dp" android:layout_height="66dp" android:src="@drawable/kz_logo_wide" android:scaleType="fitCenter" android:contentDescription="Logo de l’application" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Configure ta première playlist" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="16dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Tu as reçu un code à 6 chiffres de ton revendeur ? Choisis Active Code. Sinon, ajoute tes identifiants avec Manuel." android:textColor="@color/muted" android:textSize="16sp" android:layout_marginTop="10dp" />
<TextView android:id="@+id/setupLicense" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/muted" android:layout_marginTop="10dp" />
<Button android:id="@+id/chooseActiveCode" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="Active Code — j’ai un code à 6 chiffres" android:textColor="@color/text" android:background="@drawable/bg_button_focus" />
<Button android:id="@+id/chooseManual" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="Manuel — ajouter mes identifiants IPTV" android:textColor="@color/text" android:background="@drawable/bg_button_focus" />
<LinearLayout android:id="@+id/activeCodeBox" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
<EditText android:id="@+id/activeCodeInput" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" android:digits="0123456789" android:maxLength="6" android:singleLine="true" android:imeOptions="actionDone" android:hint="Code à 6 chiffres" android:gravity="center" android:textSize="26sp" android:textColor="@color/text" android:textColorHint="@color/muted" android:background="@drawable/bg_card" android:padding="10dp" android:importantForAutofill="no" />
<Button android:id="@+id/submitActiveCode" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="Récupérer ma playlist" android:textColor="@color/text" android:background="@drawable/bg_button_focus" />
</LinearLayout>
<ProgressBar android:id="@+id/setupProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="12dp" android:visibility="gone" />
<TextView android:id="@+id/setupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/muted" android:layout_marginTop="12dp" />
<Button android:id="@+id/refreshSetup" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Actualiser les playlists de ma licence" android:textColor="@color/text" android:background="@drawable/bg_button_focus" />
</LinearLayout></ScrollView>