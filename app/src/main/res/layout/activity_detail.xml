<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="?attr/kzBg"
    android:padding="@dimen/cl_detail_pad">

    <ImageView
        android:id="@+id/posterIv"
        android:layout_width="@dimen/cl_detail_poster_w"
        android:layout_height="@dimen/cl_detail_poster_h"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_tile"
        android:padding="4dp"
        android:src="@drawable/ic_movie" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/cl_detail_pad">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2190 Retour"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="@drawable/bg_focus_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="@dimen/cl_detail_title"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/favBtn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="\u2606 Favori"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_fav_chip"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/detailDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/castTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Équipe et distribution"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/castRv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/similarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Titres similaires"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/similarRv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/detailProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- v359 : boutons compacts, sur une seule ligne, avec un focus tres visible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/playBtn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="\u25B6  Lire"
                android:textColor="@color/btn_action_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:background="@drawable/bg_action_btn"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:clickable="true"
                android:layout_gravity="center_vertical" />
            <Button
                android:id="@+id/trailerBtn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Bande-annonce"
                android:textColor="@color/btn_action_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:background="@drawable/bg_action_btn"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical" />
            <Button
                android:id="@+id/downloadBtn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="\u2913  T\u00e9l\u00e9charger"
                android:textColor="@color/btn_action_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:includeFontPadding="false"
                android:background="@drawable/bg_action_btn"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
