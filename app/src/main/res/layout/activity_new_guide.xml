<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="?attr/kzBg">

    <include layout="@layout/newtivi_sidebar" />

    <!-- Colonne des categories (facon TiviMate) -->
    <LinearLayout
        android:layout_width="@dimen/nt_cat_col_w"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/kzBg2"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAT\u00c9GORIES"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />
        <TextView
            android:id="@+id/liveSearchBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_nflx_ghost"
            android:padding="8dp"
            android:layout_marginBottom="10dp"
            android:text="Rechercher une chaîne"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/catRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/nt_content_pad">

        <!-- En-tete : titre Guide + fil d'ariane + date / heure / Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/screenTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guide"
                    android:textColor="@color/text"
                    android:textSize="@dimen/nt_screen_title"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/sourceTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/dateTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/clockTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/optionsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Options"
                android:background="@drawable/bg_ghost_btn"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Apercu programme en cours : vignette + infos + progression -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/nt_hero_h"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <FrameLayout
                android:layout_width="@dimen/nt_hero_preview_w"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tile">
                <ImageView
                    android:id="@+id/heroImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />
                <androidx.media3.ui.PlayerView
                    android:id="@+id/heroPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:surface_type="texture_view"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="18dp">
                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="@dimen/nt_hero_title"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/heroTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/kzAccent"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_progress_track">
                    <View
                        android:id="@+id/heroProgFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.12"
                        android:background="@drawable/bg_progress_fill" />
                    <View
                        android:id="@+id/heroProgRest"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.88" />
                </LinearLayout>
                <TextView
                    android:id="@+id/heroPctTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/heroDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- En-tete des colonnes horaires -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/sectionTv"
                android:layout_width="@dimen/nt_channel_col_w"
                android:layout_height="wrap_content"
                android:text="Cha\u00eenes"
                android:paddingStart="12dp"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/timeH1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/timeH2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/timeH3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/timeH4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelRv"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/msgTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/muted"
                android:gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
